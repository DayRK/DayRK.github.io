# Supabase
# The URL and the anon key are public: the anon key is safe to expose and
# row level security still applies to it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses row level security, so never expose it to the browser
# and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Security
# Both are required. The app refuses to log anyone in when they are missing,
# and there is no fallback default.
ADMIN_PASSWORD=choose-a-long-unique-password
JWT_SECRET=paste-a-long-random-string-at-least-32-characters

# GitHub (Phase 9)
# Username is public. The token is optional: without it GitHub allows 60
# requests an hour, with it 5000. Keep the token server-only (no NEXT_PUBLIC_).
GITHUB_USERNAME=DayRK
GITHUB_TOKEN=
